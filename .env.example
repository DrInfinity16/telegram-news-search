# Telegram Bot Token — create a bot with @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key — https://aistudio.google.com/apikey
# Optional. Leave empty to disable AI features; search still works with
# deterministic fallback (original-query lexical retrieval).
GEMINI_API_KEY=your_gemini_api_key_here

# Optional configuration (defaults shown)
# DATABASE_PATH=news.db
# INGEST_INTERVAL_MINUTES=30
# EXPANSION_MODEL=gemini-3.1-flash-lite
# MAX_EXPANDED_TERMS=25
# SEARCH_CANDIDATE_LIMIT=50
